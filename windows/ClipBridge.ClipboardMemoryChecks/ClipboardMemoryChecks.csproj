<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ClipBridge.Windows/ClipboardWriteQueue.cs" Link="ClipboardWriteQueue.cs" />
    <Compile Include="../ClipBridge.Windows/ClipboardMessagePump.cs" Link="ClipboardMessagePump.cs" />
    <Compile Include="../ClipBridge.Windows/ClipboardFileCache.cs" Link="ClipboardFileCache.cs" />
    <Compile Include="../ClipBridge.Windows/BoundedMemoryQueue.cs" Link="BoundedMemoryQueue.cs" />
    <Compile Include="../ClipBridge.Windows/PayloadCodec.cs" Link="PayloadCodec.cs" />
    <Compile Include="../ClipBridge.Windows/TransferMemory.cs" Link="TransferMemory.cs" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
</Project>
